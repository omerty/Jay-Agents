# JayAgents environment variables — copy to .env and fill in

# ---------- LLM provider ----------
# Pick one: groq (recommended — free tier, fast), openai (cheap paid), ollama (local, free)
# Leave LLM_PROVIDER unset to auto-detect: GROQ_API_KEY → groq, OPENAI_API_KEY → openai, else ollama
#LLM_PROVIDER=groq

# Groq — free tier, no credit card: https://console.groq.com/keys
# Default model: llama-3.3-70b-versatile (30 req/min, 1k req/day free)
GROQ_API_KEY=
#GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI — gpt-4o-mini is ~$0.15/M input tokens. A full discover run costs well under $0.01.
#OPENAI_API_KEY=
#OPENAI_MODEL=gpt-4o-mini
# Any OpenAI-compatible endpoint works (OpenRouter, Together, etc.):
#OPENAI_BASE_URL=https://api.openai.com/v1

# Ollama — local fallback, free, no key
#OLLAMA_HOST=http://localhost:11434
#OLLAMA_MODEL=llama3.2

#LLM_TIMEOUT=120
#LLM_MAX_RETRIES=3
# Delay between LLM API calls — recommended 2.5 for Groq free tier
#LLM_CALL_DELAY=2.5
# Delay between leads during batch processing (defaults to LLM_CALL_DELAY)
#PROCESS_DELAY=2.5

# ---------- Contact search provider ----------
# Pick one: apollo (recommended — free unlimited person search) or pdl.
# Leave CONTACTS_PROVIDER unset to auto-detect: APOLLO_API_KEY → apollo, else pdl.
#CONTACTS_PROVIDER=apollo

# Apollo.io — person SEARCH is free (no credits, 230M+ contacts).
# Create a MASTER key: app.apollo.io → Settings → API Keys
APOLLO_API_KEY=
# Reveal emails via Apollo enrichment (1 Apollo credit per contact). Off by default;
# the Hunter email finder below is tried first and is free.
#APOLLO_REVEAL_EMAILS=false

# Hunter.io — email finder, free tier 25 searches/month: https://hunter.io/api-keys
# Used to attach work emails to Apollo search results.
HUNTER_API_KEY=

# People Data Labs — 100 free credits/month, every record includes a work email
# Sign up: https://www.peopledatalabs.com → Dashboard → API Keys
PDL_API_KEY=

# Seamless.AI — Keira uses this for owner contact search + enrichment (Eastern Ontario M&A).
# Search is FREE; research costs 1 credit per contact. Docs: https://docs.seamless.ai/introduction
# MCP-only: Settings → Public API → create connection with MCP scope, then SEAMLESS_TRANSPORT=mcp
# REST: https://login.seamless.ai/settings/public-api (default transport)
SEAMLESS_API_KEY=
#SEAMLESS_TRANSPORT=mcp
#SEAMLESS_MCP_URL=https://mcp.seamless.ai/mcp
# Monthly credit budget tracker (default 10,000). Research is capped per run to conserve credits.
#SEAMLESS_MONTHLY_BUDGET=10000
#SEAMLESS_KEIRA_RESEARCH_LIMIT=8

# Actava.ai — Keira prospecting while Seamless IT access is pending.
# Get credentials from https://app.actava.ai/
ACTAVA_API_KEY=
# Optional: run a prospecting agent you built in Actava (Administration → API Examples → List Agents)
#ACTAVA_AGENT_ID=
#ACTAVA_RUN_TIMEOUT=1800
#ACTAVA_POLL_INTERVAL=5
#ACTAVA_POLL_HEARTBEAT=60
#ACTAVA_STATUS_CACHE_TTL=120
#HEALTH_CACHE_TTL=120
# Platform + Cura URLs (defaults shown — usually no change needed)
#ACTAVA_PLATFORM_URL=https://api.actava.ai/v1
#ACTAVA_CURA_URL=https://inference.actava.ai/v1
#ACTAVA_CURA_MODEL=actava/cura-soar
# Optional: use Actava Cura as JayAgents LLM for qualify/outreach
#LLM_PROVIDER=actava

# DuckDuckGo web research — no key needed

# ---------- Gmail (drafts + reply scanning) ----------
# OPERATOR sets these once on the server — end users never see them.
# Create a Web OAuth client at console.cloud.google.com (Gmail API enabled).
# Authorized redirect URI: http://YOUR_HOST:8400/api/gmail/oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local-dev alternative: download OAuth JSON to ./credentials.json instead of the vars above
#GOOGLE_CREDENTIALS_PATH=./credentials.json
#GMAIL_TOKEN_PATH=./.gmail_token.json
# Dashboard checks for replies every N minutes (0 disables the background scan)
#REPLY_SCAN_MINUTES=10

# ---------- Microsoft 365 / Outlook (drafts + reply scanning) ----------
# OPERATOR sets these once — Azure portal → App registrations → New registration.
# Redirect URI (Web): http://YOUR_HOST:8400/api/microsoft/oauth/callback
# API permissions (delegated): User.Read, Mail.ReadWrite, Mail.Send + admin consent if required.
# Tenant: "common" (personal + work), "organizations", "consumers", or a specific tenant ID.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
#MICROSOFT_TENANT_ID=common
#MICROSOFT_TOKEN_PATH=./.microsoft_token.json

# ---------- Daily automation (cron — install with ./scripts/setup_cron.sh) ----------
#DAILY_CONTACT_LIMIT=10     # contacts pulled per agent per day
#DAILY_PROCESS_LIMIT=25     # imported leads qualified per agent per day
#DAILY_DRAFT_MIN_SCORE=50   # min ICP score to auto-create a Gmail draft
# Hour for cron schedule (local time) — install with: ./scripts/setup_cron.sh
#DAILY_CRON_HOUR=0

# ---------- App ----------
#LEADS_DB_PATH=./leads.db
#WEB_HOST=127.0.0.1
#WEB_PORT=8400
#LOG_LEVEL=INFO

# ---------- Dashboard auth (invite-only signup) ----------
# Set AUTH_ADMIN_SECRET to enable login (or set AUTH_ENABLED=true explicitly).
# Generate secrets: openssl rand -hex 32
#AUTH_ENABLED=true
#AUTH_SESSION_SECRET=
#AUTH_ADMIN_SECRET=
#AUTH_SESSION_TTL_HOURS=168
#AUTH_INVITE_TTL_HOURS=72
# Set true behind HTTPS (Caddy/nginx reverse proxy)
#AUTH_COOKIE_SECURE=true

# Create an invite (send the one-time code to the new user):
#   python -m src.auth invite user@example.com
# Or via API:
#   curl -X POST https://your-host/api/auth/admin/invite \
#     -H "Authorization: Bearer $AUTH_ADMIN_SECRET" \
#     -H "Content-Type: application/json" \
#     -d '{"email":"user@example.com"}'
