# JayAgents environment variables — copy to .env and fill in

# ---------- LLM provider ----------
# Pick one: groq (recommended — free tier, fast), openai (cheap paid), ollama (local, free)
# Leave LLM_PROVIDER unset to auto-detect: ANTHROPIC → groq → openai → ollama
#LLM_PROVIDER=anthropic

# Anthropic Claude — recommended primary (qualify + outreach quality)
# https://console.anthropic.com/
ANTHROPIC_API_KEY=
#ANTHROPIC_MODEL=claude-sonnet-4-6

# Groq — free-tier fallback when Claude is down / rate-limited
# https://console.groq.com/keys
GROQ_API_KEY=
#GROQ_MODEL=llama-3.3-70b-versatile
#LLM_FALLBACK=groq
# Anthropic prompt caching on repeated system prompts (qualify/outreach)
#ANTHROPIC_PROMPT_CACHE=true
# DuckDuckGo research hits per lead (default 3)
#RESEARCH_MAX_RESULTS=3
# Delay between batch lead processing (auto-tuned by provider if unset)
#PROCESS_DELAY=0.3
#LLM_CALL_DELAY=0.3

# OpenAI — gpt-4o-mini is ~$0.15/M input tokens. A full discover run costs well under $0.01.
#OPENAI_API_KEY=
#OPENAI_MODEL=gpt-4o-mini
# Any OpenAI-compatible endpoint works (OpenRouter, Together, etc.):
#OPENAI_BASE_URL=https://api.openai.com/v1

# Ollama — local fallback, free, no key
#OLLAMA_HOST=http://localhost:11434
#OLLAMA_MODEL=llama3.2

#LLM_TIMEOUT=120
#LLM_MAX_RETRIES=3
# Delay between LLM API calls — recommended 2.5 for Groq free tier
#LLM_CALL_DELAY=2.5
# Delay between leads during batch processing (defaults to LLM_CALL_DELAY)
#PROCESS_DELAY=2.5

# ---------- Contact search provider ----------
# Pick one: apollo (recommended — free unlimited person search) or pdl.
# Leave CONTACTS_PROVIDER unset to auto-detect: APOLLO_API_KEY → apollo, else pdl.
#CONTACTS_PROVIDER=apollo

# Apollo.io — person SEARCH is free (no credits, 230M+ contacts).
# Create a MASTER key: app.apollo.io → Settings → API Keys
APOLLO_API_KEY=
# Reveal emails via Apollo enrichment (1 Apollo credit per contact). Off by default;
# the Hunter email finder below is tried first and is free.
#APOLLO_REVEAL_EMAILS=false

# Hunter.io — email finder, free tier 25 searches/month: https://hunter.io/api-keys
# HUNTER_MODE=domain_search uses 1 credit per company domain (not per person).
HUNTER_API_KEY=
#HUNTER_MODE=domain_search
#EMAIL_PATTERN_CACHE=true
#WOODWAY_HUNTER_EMAIL=false

# Brave Search API — 2,000 queries/month free: https://brave.com/search/api/
#BRAVE_SEARCH_API_KEY=
#SEARCH_PROVIDER=auto
#SERP_CACHE_TTL_HOURS=168

# Signals, sequences, model routing (Woodway Phase 2+)
#SIGNALS_ENABLED=true
#SEQUENCE_ENABLED=true
#QUALIFY_TWO_PASS=true
#OUTREACH_CRITIQUE=true
#MODEL_EXTRACTION=claude-haiku-4-5
#MODEL_QUALIFY=claude-sonnet-4-6
#MODEL_OUTREACH=claude-sonnet-4-6
#MODEL_CRITIQUE=claude-haiku-4-5
#MAX_RUN_COST_USD=5.00
#SUPPRESSION_ENABLED=true
#RETENTION_MONTHS=18
#REQUIRE_OPT_OUT_FOOTER=true

# Keira Phase 2 — Claude analyst/critic + credit caps (company-first pipeline)
#KEIRA_CLAUDE_RESEARCH=true
#KEIRA_CLAUDE_CRITIC=true
#KEIRA_CLAUDE_RESEARCH_CAP=8
#KEIRA_SEAMLESS_ENRICH_CAP=8

# Keira Phase 3 — research memory + event rediscovery + eval
#KEIRA_RESEARCH_MEMORY=true
#KEIRA_RESEARCH_COOLDOWN_DAYS=90
#KEIRA_EVENT_REDISCOVERY=true
# Run regression: python -m src.keira_eval --strict

# Keira contact discovery (same modes as Woodway: auto|web|seamless|paid)
# auto = Seamless when connected, else web (DDG + Claude) + Hunter/Apollo fallbacks
#KEIRA_CONTACT_DISCOVERY=seamless

# People Data Labs — 100 free credits/month, every record includes a work email
# Sign up: https://www.peopledatalabs.com → Dashboard → API Keys
PDL_API_KEY=

# Seamless.AI — Keira uses this for owner contact search + enrichment (Eastern Ontario M&A).
# Search is FREE; research costs 1 credit per contact. Docs: https://docs.seamless.ai/introduction
# MCP-only: Settings → Public API → create connection with MCP scope, then SEAMLESS_TRANSPORT=mcp
# REST: https://login.seamless.ai/settings/public-api (default transport)
SEAMLESS_API_KEY=
# OAuth — sign in with your Seamless web account (uses your plan credits, not limited API key):
# Settings → Public API → OAuth Connections
# Redirect URI: http://YOUR_HOST:8400/api/seamless/oauth/callback
#SEAMLESS_CLIENT_ID=
#SEAMLESS_CLIENT_SECRET=
#SEAMLESS_TOKEN_PATH=./.seamless_token.json
#SEAMLESS_TRANSPORT=mcp
#SEAMLESS_MCP_URL=https://mcp.seamless.ai/mcp
# Monthly / daily credit budgets (research only — search is free).
# 10k/mo plan: a run may overshoot its per-run cap by 10–20 credits.
# Daily hard cap stays well under 1000.
#SEAMLESS_RESEARCH_ENABLED=true
#SEAMLESS_MONTHLY_BUDGET=10000
#SEAMLESS_DAILY_BUDGET=200
#SEAMLESS_DAILY_HARD_CAP=250
#SEAMLESS_RUN_OVERAGE=20
# Per-agent daily sub-caps (sum should be ≤ shared daily; overage still bounded by hard cap)
#SEAMLESS_DAILY_BUDGET_WOODWAY=120
#SEAMLESS_DAILY_BUDGET_KEIRA=80
#SEAMLESS_KEIRA_RESEARCH_LIMIT=25
# Woodway daily target ~50 companies × 1 contact (coverage-first)
#SEAMLESS_WOODWAY_RESEARCH_LIMIT=50
#SEAMLESS_WOODWAY_CONTACTS_PER_COMPANY=1
#SEAMLESS_MAX_RESEARCH_PER_RUN=50
#SEAMLESS_MIN_RESERVE=50
#KEIRA_SEAMLESS_ENRICH_CAP=25
#REQUIRE_MAILBOX_FOR_PIPELINE=true
#HUNTER_PEOPLE_SEARCH=false
#RETENTION_MONTHS=18
#DOMAIN_CONFIDENCE_MIN=0.5

# Actava.ai — company discovery (stackable with Seamless + Anthropic for Keira).
# Get credentials from https://app.actava.ai/
ACTAVA_API_KEY=
# Optional: Woodway / shared Actava prospecting agent (Administration → List Agents)
#ACTAVA_AGENT_ID=
# Optional: dedicated Keira M&A agent (do not reuse Woodway EviData agent)
#ACTAVA_AGENT_ID_KEIRA=
# Set true only if you intentionally want Keira to call ACTAVA_AGENT_ID
#KEIRA_USE_SHARED_ACTAVA_AGENT=false
#ACTAVA_RUN_TIMEOUT=1800
#ACTAVA_POLL_INTERVAL=5
#ACTAVA_POLL_HEARTBEAT=60
#ACTAVA_STATUS_CACHE_TTL=120
#HEALTH_CACHE_TTL=120
# Platform + Cura URLs (defaults shown — usually no change needed)
#ACTAVA_PLATFORM_URL=https://api.actava.ai/v1
#ACTAVA_CURA_URL=https://inference.actava.ai/v1
#ACTAVA_CURA_MODEL=actava/cura-soar
# Optional: use Actava Cura as JayAgents LLM for qualify/outreach
#LLM_PROVIDER=actava
# Keira discovery stacking (default on in agents/keira/config.yaml)
#KEIRA_STACK_ACTAVA=true
#KEIRA_STACK_ANTHROPIC=true
#KEIRA_ENRICH_MIN_TIER=1
#KEIRA_DRAFT_MIN_TIER=2
# Woodway pipeline step 1: anthropic (fast — web + Claude) or actava (slow external agent)
#WOODWAY_COMPANY_DISCOVERY=anthropic
# Woodway pipeline step 3: auto (Seamless OAuth/API if connected, else web), web, seamless, paid
#WOODWAY_CONTACT_DISCOVERY=web
# Hunter domain-search — 1 credit per company (pattern ladder last resort + optional people fallback)
#HUNTER_MODE=domain_search
#HUNTER_DOMAIN_LIMIT=50
#HUNTER_PEOPLE_SEARCH=true
# Deep web contact research — yield over frugality (raise freely; $3 runs are fine)
#WEB_CONTACT_QUERIES=10
#WEB_CONTACT_RESULTS=12
#WEB_CONTACT_FETCH_PAGES=true
#WEB_CONTACT_PAGE_FETCH=5
#RESEARCH_MAX_RESULTS=12
#EMAIL_PATTERN_CACHE=true

# DuckDuckGo web research — no key needed

# ---------- Gmail (drafts + reply scanning) ----------
# OPERATOR sets these once on the server — end users never see them.
# Create a Web OAuth client at console.cloud.google.com (Gmail API enabled).
# Authorized redirect URI: http://YOUR_HOST:8400/api/gmail/oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local-dev alternative: download OAuth JSON to ./credentials.json instead of the vars above
#GOOGLE_CREDENTIALS_PATH=./credentials.json
#GMAIL_TOKEN_PATH=./.gmail_token.json
# Dashboard checks for replies every N minutes (0 disables the background scan)
#REPLY_SCAN_MINUTES=10

# ---------- Microsoft 365 / Outlook (drafts + reply scanning) ----------
# OPERATOR sets these once — Azure portal → App registrations → New registration.
# Redirect URI (Web): http://YOUR_HOST:8400/api/microsoft/oauth/callback
# API permissions (delegated): User.Read, Mail.ReadWrite, Mail.Send + admin consent if required.
# Tenant: "common" (personal + work), "organizations", "consumers", or a specific tenant ID.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
#MICROSOFT_TENANT_ID=common
#MICROSOFT_TOKEN_PATH=./.microsoft_token.json

# ---------- Daily automation (cron — install with ./scripts/setup_cron.sh) ----------
# Woodway target: ~50 new companies/day with ≥1 contact each (~50 Seamless credits)
#DAILY_CONTACT_LIMIT=50     # default contacts/companies per agent per day
#DAILY_WOODWAY_LIMIT=50     # Woodway pipeline company target (defaults to DAILY_CONTACT_LIMIT)
#DAILY_PROCESS_LIMIT=50     # imported leads qualified per agent per day
#DAILY_DRAFT_MIN_SCORE=50   # min ICP score to auto-create a Gmail draft
#EMAIL_TIER_MIN_FOR_DRAFT=B # A=verified only, B=allow inferred
#EMAIL_VERIFY_BEFORE_DRAFT=true
#DOMAIN_CONFIDENCE_MIN=0.5  # skip pattern emails below this domain confidence
#SUPPRESS_DOMAIN_ON_NEGATIVE=false  # keep true only if you want whole-domain suppress
#SEQUENCE_ENABLED=true
#SEQUENCE_INTERVALS=0,4,8,16
#WOODWAY_COMPANY_DISCOVERY=anthropic  # or actava
#WOODWAY_CONTACT_DISCOVERY=seamless   # auto|web|seamless|paid — seamless for 1 contact/company
#OUTREACH_REQUIRE_CITATIONS=true   # reject drafts with uncited product/factual claims
#ACCOUNT_BRIEFS_ENABLED=true       # assemble per-account research brief before writing
#ACCOUNT_BRIEF_TTL_DAYS=14
#ACCOUNT_BRIEF_FILINGS=false       # set true to pull SEC filing emails into briefs (slower)
#OUTREACH_EVAL_LLM=false           # set true when running: python -m src.outreach_eval --llm
# Hour for cron schedule (local time) — install with: ./scripts/setup_cron.sh
#DAILY_CRON_HOUR=0

# ---------- App ----------
#LEADS_DB_PATH=./leads.db
#WEB_HOST=127.0.0.1
#WEB_PORT=8400
#LOG_LEVEL=INFO

# ---------- Dashboard auth (invite-only signup) ----------
# Set AUTH_ADMIN_SECRET to enable login (or set AUTH_ENABLED=true explicitly).
# Generate secrets: openssl rand -hex 32
#AUTH_ENABLED=true
#AUTH_SESSION_SECRET=
#AUTH_ADMIN_SECRET=
#AUTH_SESSION_TTL_HOURS=168
#AUTH_INVITE_TTL_HOURS=72
# Set true behind HTTPS (Caddy/nginx reverse proxy)
#AUTH_COOKIE_SECURE=true

# Create an invite (send the one-time code to the new user):
#   python -m src.auth invite user@example.com
# Or via API:
#   curl -X POST https://your-host/api/auth/admin/invite \
#     -H "Authorization: Bearer $AUTH_ADMIN_SECRET" \
#     -H "Content-Type: application/json" \
#     -d '{"email":"user@example.com"}'
